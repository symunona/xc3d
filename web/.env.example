# XC3D web env — copy this to web/.env and fill it in:  cp web/.env.example web/.env
#
# MapTiler token (the FREE tier is plenty). Powers the terrain DEM — 3D relief, AGL
# readouts, the sun hillshade + cast shadows — and the MapTiler basemaps. Without it,
# only the offline OpenTopoMap / Relief basemaps render and the sun/terrain features
# are unavailable. Get a free token at https://cloud.maptiler.com/account/keys/
VITE_MAP_TILER_ACCESS_TOKEN=
